      fUpdate =3D true;
    }
   =20
    if ( cx < cy*0.66 )
    {
      document.styleSheets[1].addRule("#" + imgPage.id, =
"height:95%;width:auto");
    }
   =20
    if ( imgPage.id =3D=3D "Page"+g_kiLastPage )
    {
      g_cyLast =3D cy;
      fUpdate =3D true;
    }
   =20
    if ( g_ieVer =3D=3D 0 )
    {
